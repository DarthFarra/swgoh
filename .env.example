# .env.example
# ============================================================
# Single unified environment configuration.
# Copy to .env and fill in your values.
#
# ALL services (bot, sync_guilds, sync_data, send_assignments)
# now run in the same process and share this file.
# ============================================================


# ------------------------------------------------------------
# Comlink
# URL of the swgoh-comlink service (no trailing slash)
# ------------------------------------------------------------
COMLINK_BASE=https://your-comlink-service.up.railway.app


# ------------------------------------------------------------
# Google credentials
# Exactly ONE of these is required. Try in order:
#   1. SERVICE_ACCOUNT_FILE — path to JSON file on disk (Pi)
#      or the raw JSON string, or base64-encoded JSON string
#   2. GOOGLE_SERVICE_ACCOUNT_JSON — raw JSON string
#   3. GOOGLE_SERVICE_ACCOUNT_BASE64 — base64-encoded JSON
# ------------------------------------------------------------
SERVICE_ACCOUNT_FILE=


# ------------------------------------------------------------
# Google Sheets identity
# Either SPREADSHEET_ID (preferred) or SPREADSHEET_NAME.
# ------------------------------------------------------------
SPREADSHEET_ID=your_spreadsheet_id_here
# SPREADSHEET_NAME=Your Sheet Name


# ------------------------------------------------------------
# Tab names
# These defaults match the standard setup.
# Override only if your sheet uses different tab names.
# ------------------------------------------------------------
SHEET_GUILDS=Guilds
SHEET_PLAYERS=Players
SHEET_PLAYER_UNITS=Player_Units
SHEET_PLAYER_SKILLS=Player_Skills
SHEET_CHARACTERS=Characters
SHEET_SHIPS=Ships
SHEET_USERS=Usuarios
SHEET_ASSIGNMENTS=Asignaciones ROTE
SHEET_TICKET_SNAPSHOTS=Ticket_Snapshots


# ------------------------------------------------------------
# Telegram bot
# ------------------------------------------------------------
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Chat IDs authorised to run /syncdata (comma-separated)
SYNC_DATA_ALLOWED_CHATS=7367477801,30373681

# Chat IDs authorised to run /syncguild.
# Defaults to SYNC_DATA_ALLOWED_CHATS if not set.
SYNC_GUILD_ALLOWED_CHATS=7367477801,30373681


# ------------------------------------------------------------
# Timezone
# Any valid IANA timezone name.
# Used for phase calculation, scheduled jobs, and timestamps.
# ------------------------------------------------------------
TIMEZONE=Europe/Madrid


# ------------------------------------------------------------
# Scheduled jobs
#
# SEND_ASSIGNMENTS_TIME: HH:MM (24h) in TIMEZONE
# SYNC_GUILDS_CRON: full cron expression, runs in TIMEZONE
# SYNC_DATA_CRON:   full cron expression, runs in TIMEZONE
# ------------------------------------------------------------
SEND_ASSIGNMENTS_TIME=19:10
SYNC_GUILDS_CRON=0 3 * * 0
SYNC_DATA_CRON=0 2 1 * *

# Lead time (in minutes) for the automatic ticket reminder posted to each
# guild's announcements channel. The reminder fires at (reset_time − N min)
# per guild, computed from the Guilds sheet's reset_time column.
# Default 60. Set to 30 for half-hour warnings, 90 for earlier nudges, etc.
TICKET_REMINDER_LEAD_MINUTES=60


# ------------------------------------------------------------
# Data filters (optional)
# Comma-separated substrings. Units/skills whose baseId or
# skillId contains any of these will be excluded from syncs.
# ------------------------------------------------------------
EXCLUDE_BASEID_CONTAINS=SUMMON,TEST_


# ------------------------------------------------------------
# Localisation (optional)
# Used by comlink data fetches.
# ------------------------------------------------------------
LOCALE=ENG_US


# ------------------------------------------------------------
# HTTP behaviour (optional — sensible defaults shown)
# ------------------------------------------------------------
HTTP_RETRIES=5
HTTP_BACKOFF_SECONDS=1.0
HTTP_TIMEOUT_SECONDS=30.0


# ------------------------------------------------------------
# Omicron mode map (optional)
# JSON blob mapping omicronMode integer to display string.
# ------------------------------------------------------------
OMICRON_MODE_MAP_JSON={"1":"Territory War","2":"Grand Arena"}


# ------------------------------------------------------------
# /omicrones command (optional)
#
# OMICRON_MIN_RELIC: minimum relic level a character must have for
#   its omicron to appear in /omicrones recommendations. Default 5
#   (R5). Set to 0 to include any unlocked character regardless of
#   relic level.
#
# OMICRON_RECOMMEND_TOP_N: maximum recommendations returned per
#   /omicrones invocation. Default 5.
#
# SHEET_OMICRON_PRIORITIES: tab name for guild/mode priorities.
#   Default 'OmicronPriorities'. The bot auto-creates it (headers
#   only) on first /omicrones run. Officers maintain its contents.
#
# SHEET_CHARACTERS_OMICRONS / SHEET_CHARACTERS_ZETAS: tab names
#   for the catalogs rewritten by /syncdata. Override only if your
#   sheet uses different tab names.
# ------------------------------------------------------------
OMICRON_MIN_RELIC=5
OMICRON_RECOMMEND_TOP_N=5
SHEET_OMICRON_PRIORITIES=OmicronPriorities
SHEET_CHARACTERS_OMICRONS=CharactersOmicrons
SHEET_CHARACTERS_ZETAS=CharactersZetas
 
# ------------------------------------------------------------
# Discord listener (TB export bridge)
# All required only if you want the Discord → Telegram bridge.
# Leave blank to disable Discord integration entirely.
# ------------------------------------------------------------

# Bot token from Discord developer portal (treat as secret)
DISCORD_BOT_TOKEN=

# C3PO bot's numeric user ID in your Discord server
DISCORD_C3PO_USER_ID=

# Numeric ID of the channel where /tb export runs
DISCORD_WATCH_CHANNEL_ID=

# Telegram chat ID that receives auto-forwarded TB summaries.
# Group chat IDs are negative numbers.
TB_AUTO_FORWARD_CHAT_ID=

# Optional: which Telegram chats can run /tb_status, /tb_top etc.
# Defaults to SYNC_DATA_ALLOWED_CHATS if not set.
# TB_REPORTS_ALLOWED_CHATS=
